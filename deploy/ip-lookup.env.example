# /etc/ip-lookup.env — read by systemd (chmod 600, owned by root).

# Address the HTTP server binds; put a reverse proxy in front of it.
LISTEN=127.0.0.1:8990
# Where datasets are downloaded; created by systemd's StateDirectory.
DATA_DIR=/var/lib/ip-lookup
# Trust X-Real-IP / X-Forwarded-* from loopback peers (the local nginx).
TRUST_PROXY=1
# Contact put in the User-Agent; bgp.tools asks for one.
CONTACT=https://github.com/zzusec/ip-lookup
# Resolvers used for PTR, Team Cymru and DNSBL queries.
DNS_SERVERS=1.1.1.1:53,8.8.8.8:53
# Set to 0 to disable background dataset downloads.
UPDATE=1

# Optional API keys. Empty values use the free anonymous tiers.
IPINFO_TOKEN=
IPAPIIS_KEY=
PROXYCHECK_KEY=
IP2LOCATION_KEY=
GREYNOISE_KEY=
